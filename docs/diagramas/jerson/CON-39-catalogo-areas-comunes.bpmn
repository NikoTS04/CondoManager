<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="CON_39_Definitions" targetNamespace="https://condomanager.local/bpmn/jerson" exporter="CondoManager — diagramas de Jerson" exporterVersion="1.0">
  <bpmn:process id="CON_39_Process" name="Administrar el catálogo de áreas comunes" isExecutable="false">
    <bpmn:documentation>Responsable de la historia: Jerson. PROC-04 · Sprint 2 · Mantenimiento administrativo y consulta del catálogo por residentes
Crear o modificar: nombre, descripción, aforo, horarios, costo decimal no negativo y estado; validar pertenencia al condominio autorizado.
Desactivar impide nuevas reservas y conserva reservas previas e historial. Persistencia y auditoría confirman juntas; un fallo revierte la operación.
La consulta se inicia de forma independiente: valida sesión y contexto y muestra las áreas activas con sus reglas de uso y reserva.
Fuente: docs/sprints/SPRINT-2.md#con-39--administrar-el-catálogo-de-áreas-comunes</bpmn:documentation>
    <bpmn:laneSet id="CON_39_LaneSet">
      <bpmn:lane id="CON_39_Lane_0" name="Administración">
        <bpmn:flowNodeRef>CON_39_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_operacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_seleccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_39_Lane_1" name="Sistema CondoManager">
        <bpmn:flowNodeRef>CON_39_autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_permiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_denegar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_denegado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_comprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_existe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_sin_cambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_desactivar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_unir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_consultar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_39_Lane_2" name="Residente">
        <bpmn:flowNodeRef>CON_39_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_abrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_39_consultado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CON_39_inicio" name="Gestionar catálogo">
      <bpmn:outgoing>CON_39_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CON_39_solicitar" name="Seleccionar condominio y solicitar mantenimiento">
      <bpmn:incoming>CON_39_Flow_0</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_39_autorizar" name="Validar sesión, rol administrativo y contexto">
      <bpmn:incoming>CON_39_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_39_permiso" name="¿Acceso autorizado?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_39_Flow_2</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>CON_39_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_39_denegar" name="Rechazar por falta de autorización">
      <bpmn:incoming>CON_39_Flow_3</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_39_denegado" name="Acceso denegado">
      <bpmn:incoming>CON_39_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CON_39_operacion" name="¿Operación solicitada?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_39_Flow_5</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>CON_39_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_39_formulario" name="Ingresar o corregir datos y reglas del área">
      <bpmn:incoming>CON_39_Flow_6</bpmn:incoming>
      <bpmn:incoming>CON_39_Flow_10</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_39_validar" name="Validar aforo, horarios, costo y pertenencia del área">
      <bpmn:incoming>CON_39_Flow_7</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_39_valido" name="¿Datos válidos?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_39_Flow_8</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>CON_39_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_39_corregir" name="Revisar errores informados">
      <bpmn:incoming>CON_39_Flow_9</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_39_guardar" name="Guardar área y auditoría en una transacción">
      <bpmn:incoming>CON_39_Flow_11</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_39_seleccionar" name="Seleccionar área a desactivar">
      <bpmn:incoming>CON_39_Flow_13</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_39_comprobar" name="Verificar existencia y pertenencia del área">
      <bpmn:incoming>CON_39_Flow_14</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_39_existe" name="¿Área del contexto existente?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_39_Flow_15</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>CON_39_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_39_error" name="Informar recurso inexistente sin modificar el catálogo">
      <bpmn:incoming>CON_39_Flow_16</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_39_sin_cambio" name="Catálogo sin cambios">
      <bpmn:incoming>CON_39_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_39_desactivar" name="Desactivar área y auditar conservando el historial">
      <bpmn:incoming>CON_39_Flow_18</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_39_unir" name="" gatewayDirection="Converging">
      <bpmn:incoming>CON_39_Flow_12</bpmn:incoming>
      <bpmn:incoming>CON_39_Flow_19</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_39_resultado" name="Revisar configuración y estado del área">
      <bpmn:incoming>CON_39_Flow_20</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CON_39_fin" name="Catálogo actualizado">
      <bpmn:incoming>CON_39_Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_39_consulta" name="Consultar áreas">
      <bpmn:outgoing>CON_39_Flow_22</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CON_39_abrir" name="Abrir catálogo de áreas comunes">
      <bpmn:incoming>CON_39_Flow_22</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_39_consultar" name="Validar sesión y consultar áreas activas del contexto">
      <bpmn:incoming>CON_39_Flow_23</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_39_mostrar" name="Consultar aforo, horarios, costo y reglas de uso">
      <bpmn:incoming>CON_39_Flow_24</bpmn:incoming>
      <bpmn:outgoing>CON_39_Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CON_39_consultado" name="Catálogo consultado">
      <bpmn:incoming>CON_39_Flow_25</bpmn:incoming>
    </bpmn:endEvent>

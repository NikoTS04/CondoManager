      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_39_Flow_10" sourceRef="CON_39_corregir" targetRef="CON_39_formulario" />
    <bpmn:sequenceFlow id="CON_39_Flow_11" sourceRef="CON_39_valido" targetRef="CON_39_guardar" name="Sí">

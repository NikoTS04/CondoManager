<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="CON_04_Definitions" targetNamespace="https://condomanager.local/bpmn/jerson" exporter="CondoManager — diagramas de Jerson" exporterVersion="1.0">
  <bpmn:process id="CON_04_Process" name="Crear usuarios y habilitar su acceso" isExecutable="false">
    <bpmn:documentation>Responsable de la historia: Jerson. PROC-05 · Sprint 2 · Alta administrativa, activación y autenticación persistente
Alta: correo y documento únicos; contraseña inicial almacenada con hash. La cuenta nace INACTIVA con rol contextual RESIDENTE y sin vínculos.
Solo SuperAdmin habilita o deshabilita la identidad. Cada cambio real de estado audita e invalida sesiones; reactivar exige nuevo login.
Login verifica credenciales, cuenta activa y asignaciones vigentes. Si hay varios condominios, el usuario selecciona contexto antes de recibir el JWT.
Fuente: specs/02-domains/05-usuarios-rbac/alta-administrativa.md</bpmn:documentation>
    <bpmn:laneSet id="CON_04_LaneSet">
      <bpmn:lane id="CON_04_Lane_0" name="Administración">
        <bpmn:flowNodeRef>CON_04_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_formulario</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_04_Lane_1" name="Sistema CondoManager">
        <bpmn:flowNodeRef>CON_04_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_sin_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_activar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_credenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_acceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_denegar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_sin_acceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_sesion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_04_Lane_2" name="SuperAdmin">
        <bpmn:flowNodeRef>CON_04_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_habilitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_inactiva</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_04_Lane_3" name="Usuario">
        <bpmn:flowNodeRef>CON_04_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_04_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CON_04_inicio" name="Solicitud de alta">
      <bpmn:outgoing>CON_04_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CON_04_formulario" name="Ingresar identidad y contraseña inicial">
      <bpmn:incoming>CON_04_Flow_0</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_04_validar" name="Validar actor, contexto, datos y unicidad">
      <bpmn:incoming>CON_04_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_04_valido" name="¿Alta válida y autorizada?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_04_Flow_2</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>CON_04_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_04_rechazar" name="Informar permiso insuficiente o datos inválidos">
      <bpmn:incoming>CON_04_Flow_3</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_04_sin_alta" name="Alta no realizada">
      <bpmn:incoming>CON_04_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_04_crear" name="Crear cuenta INACTIVA, hash, rol RESIDENTE y auditoría">
      <bpmn:incoming>CON_04_Flow_5</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_04_revisar" name="Revisar cuenta y decidir su habilitación">
      <bpmn:incoming>CON_04_Flow_6</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_04_habilitar" name="¿Habilitar acceso?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_04_Flow_7</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>CON_04_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CON_04_inactiva" name="Cuenta permanece inactiva">
      <bpmn:incoming>CON_04_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_04_activar" name="Activar cuenta; guardar revisión y auditoría atómicas">
      <bpmn:incoming>CON_04_Flow_9</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_04_login" name="Ingresar correo y contraseña para iniciar sesión">
      <bpmn:incoming>CON_04_Flow_10</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_04_credenciales" name="Verificar credenciales, cuenta activa y roles vigentes">
      <bpmn:incoming>CON_04_Flow_11</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_04_acceso" name="¿Autenticación válida?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_04_Flow_12</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>CON_04_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_04_denegar" name="Denegar acceso con error de autenticación">
      <bpmn:incoming>CON_04_Flow_13</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_04_sin_acceso" name="Login rechazado">
      <bpmn:incoming>CON_04_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_04_sesion" name="Resolver contexto y emitir JWT con perfil vigente">
      <bpmn:incoming>CON_04_Flow_15</bpmn:incoming>
      <bpmn:outgoing>CON_04_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_04_fin" name="Acceso habilitado">
      <bpmn:incoming>CON_04_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CON_04_Flow_0" sourceRef="CON_04_inicio" targetRef="CON_04_formulario" />
    <bpmn:sequenceFlow id="CON_04_Flow_1" sourceRef="CON_04_formulario" targetRef="CON_04_validar" />
    <bpmn:sequenceFlow id="CON_04_Flow_2" sourceRef="CON_04_validar" targetRef="CON_04_valido" />
    <bpmn:sequenceFlow id="CON_04_Flow_3" sourceRef="CON_04_valido" targetRef="CON_04_rechazar" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_4" sourceRef="CON_04_rechazar" targetRef="CON_04_sin_alta" />
    <bpmn:sequenceFlow id="CON_04_Flow_5" sourceRef="CON_04_valido" targetRef="CON_04_crear" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_6" sourceRef="CON_04_crear" targetRef="CON_04_revisar" />
    <bpmn:sequenceFlow id="CON_04_Flow_7" sourceRef="CON_04_revisar" targetRef="CON_04_habilitar" />
    <bpmn:sequenceFlow id="CON_04_Flow_8" sourceRef="CON_04_habilitar" targetRef="CON_04_inactiva" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_9" sourceRef="CON_04_habilitar" targetRef="CON_04_activar" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_10" sourceRef="CON_04_activar" targetRef="CON_04_login" />
    <bpmn:sequenceFlow id="CON_04_Flow_11" sourceRef="CON_04_login" targetRef="CON_04_credenciales" />
    <bpmn:sequenceFlow id="CON_04_Flow_12" sourceRef="CON_04_credenciales" targetRef="CON_04_acceso" />
    <bpmn:sequenceFlow id="CON_04_Flow_13" sourceRef="CON_04_acceso" targetRef="CON_04_denegar" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_14" sourceRef="CON_04_denegar" targetRef="CON_04_sin_acceso" />
    <bpmn:sequenceFlow id="CON_04_Flow_15" sourceRef="CON_04_acceso" targetRef="CON_04_sesion" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_04_Flow_16" sourceRef="CON_04_sesion" targetRef="CON_04_fin" />
  </bpmn:process>
  <bpmn:collaboration id="CON_04_Collaboration">
    <bpmn:participant id="CON_04_Participant" name="CondoManager · CON-04" processRef="CON_04_Process" />
  </bpmn:collaboration>

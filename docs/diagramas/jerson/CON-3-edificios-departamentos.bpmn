<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="CON_3_Definitions" targetNamespace="https://condomanager.local/bpmn/jerson" exporter="CondoManager — diagramas de Jerson" exporterVersion="1.0">
  <bpmn:process id="CON_3_Process" name="Registrar edificios y departamentos" isExecutable="false">
    <bpmn:documentation>Responsable de la historia: Jerson. PROC-05 · Sprint 1 · Registro manual e importación CSV con resultados por fila
Escritura: SuperAdmin o Junta del condominio. Edificio y número normalizado identifican una unidad; se utiliza UUID para operar.
CSV: previsualizar no guarda datos. Confirmar revalida, crea filas válidas y reporta errores; los reintentos idénticos no duplican unidades.
Coeficientes con Decimal y cuatro decimales. Persistencia y auditoría atómicas; un fallo inesperado revierte toda la solicitud.
Fuente: specs/02-domains/05-usuarios-rbac/estructura-inmobiliaria.md</bpmn:documentation>
    <bpmn:laneSet id="CON_3_LaneSet">
      <bpmn:lane id="CON_3_Lane_0" name="Administración">
        <bpmn:flowNodeRef>CON_3_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_modalidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_csv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_cancelar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_3_Lane_1" name="Sistema CondoManager">
        <bpmn:flowNodeRef>CON_3_autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_permiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_sin_permiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_fin_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_previsualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_importar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_reporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_3_fin_csv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CON_3_inicio" name="Necesidad de registro">
      <bpmn:outgoing>CON_3_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CON_3_solicitud" name="Seleccionar condominio y solicitar registro">
      <bpmn:incoming>CON_3_Flow_0</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_3_autorizar" name="Validar identidad, permisos y condominio activo">
      <bpmn:incoming>CON_3_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_3_permiso" name="¿Acceso autorizado?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_3_Flow_2</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>CON_3_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_3_rechazar" name="Rechazar solicitud y mostrar motivo">
      <bpmn:incoming>CON_3_Flow_3</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_3_sin_permiso" name="Solicitud rechazada">
      <bpmn:incoming>CON_3_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CON_3_modalidad" name="¿Modalidad de registro?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_3_Flow_5</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>CON_3_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_3_manual" name="Ingresar edificio o departamento">
      <bpmn:incoming>CON_3_Flow_6</bpmn:incoming>
      <bpmn:incoming>CON_3_Flow_11</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_3_validar" name="Validar datos, piso, coeficiente y duplicados">
      <bpmn:incoming>CON_3_Flow_8</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_3_valido" name="¿Datos válidos y únicos?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_3_Flow_9</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>CON_3_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_3_corregir" name="Corregir datos informados">
      <bpmn:incoming>CON_3_Flow_10</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_3_guardar" name="Guardar registro y auditoría en una transacción">
      <bpmn:incoming>CON_3_Flow_12</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_3_fin_manual" name="Estructura registrada">
      <bpmn:incoming>CON_3_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CON_3_csv" name="Seleccionar y cargar archivo CSV">
      <bpmn:incoming>CON_3_Flow_7</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_3_previsualizar" name="Validar CSV y previsualizar resultados sin guardar">
      <bpmn:incoming>CON_3_Flow_14</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_3_revisar" name="Revisar vista previa y errores por fila">
      <bpmn:incoming>CON_3_Flow_15</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_3_confirmar" name="¿Confirmar importación?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_3_Flow_16</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>CON_3_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CON_3_cancelar" name="Importación cancelada">
      <bpmn:incoming>CON_3_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_3_importar" name="Revalidar y guardar filas válidas con auditoría">
      <bpmn:incoming>CON_3_Flow_18</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CON_3_reporte" name="Mostrar filas creadas, existentes y con error">
      <bpmn:incoming>CON_3_Flow_19</bpmn:incoming>
      <bpmn:outgoing>CON_3_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_3_fin_csv" name="Importación procesada">
      <bpmn:incoming>CON_3_Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CON_3_Flow_0" sourceRef="CON_3_inicio" targetRef="CON_3_solicitud" />
    <bpmn:sequenceFlow id="CON_3_Flow_1" sourceRef="CON_3_solicitud" targetRef="CON_3_autorizar" />
    <bpmn:sequenceFlow id="CON_3_Flow_2" sourceRef="CON_3_autorizar" targetRef="CON_3_permiso" />
    <bpmn:sequenceFlow id="CON_3_Flow_3" sourceRef="CON_3_permiso" targetRef="CON_3_rechazar" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_4" sourceRef="CON_3_rechazar" targetRef="CON_3_sin_permiso" />
    <bpmn:sequenceFlow id="CON_3_Flow_5" sourceRef="CON_3_permiso" targetRef="CON_3_modalidad" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_6" sourceRef="CON_3_modalidad" targetRef="CON_3_manual" name="Manual">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Manual</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_7" sourceRef="CON_3_modalidad" targetRef="CON_3_csv" name="CSV">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">CSV</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_8" sourceRef="CON_3_manual" targetRef="CON_3_validar" />
    <bpmn:sequenceFlow id="CON_3_Flow_9" sourceRef="CON_3_validar" targetRef="CON_3_valido" />
    <bpmn:sequenceFlow id="CON_3_Flow_10" sourceRef="CON_3_valido" targetRef="CON_3_corregir" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_11" sourceRef="CON_3_corregir" targetRef="CON_3_manual" />
    <bpmn:sequenceFlow id="CON_3_Flow_12" sourceRef="CON_3_valido" targetRef="CON_3_guardar" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_13" sourceRef="CON_3_guardar" targetRef="CON_3_fin_manual" />
    <bpmn:sequenceFlow id="CON_3_Flow_14" sourceRef="CON_3_csv" targetRef="CON_3_previsualizar" />
    <bpmn:sequenceFlow id="CON_3_Flow_15" sourceRef="CON_3_previsualizar" targetRef="CON_3_revisar" />
    <bpmn:sequenceFlow id="CON_3_Flow_16" sourceRef="CON_3_revisar" targetRef="CON_3_confirmar" />
    <bpmn:sequenceFlow id="CON_3_Flow_17" sourceRef="CON_3_confirmar" targetRef="CON_3_cancelar" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_18" sourceRef="CON_3_confirmar" targetRef="CON_3_importar" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_3_Flow_19" sourceRef="CON_3_importar" targetRef="CON_3_reporte" />
    <bpmn:sequenceFlow id="CON_3_Flow_20" sourceRef="CON_3_reporte" targetRef="CON_3_fin_csv" />
  </bpmn:process>
  <bpmn:collaboration id="CON_3_Collaboration">
    <bpmn:participant id="CON_3_Participant" name="CondoManager · CON-3" processRef="CON_3_Process" />
  </bpmn:collaboration>

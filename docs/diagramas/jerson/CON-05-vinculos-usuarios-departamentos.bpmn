<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="CON_05_Definitions" targetNamespace="https://condomanager.local/bpmn/jerson" exporter="CondoManager — diagramas de Jerson" exporterVersion="1.0">
  <bpmn:process id="CON_05_Process" name="Vincular usuarios con departamentos" isExecutable="false">
    <bpmn:documentation>Responsable de la historia: Jerson. PROC-05 · Sprint 2 · Alta, cambio, restauración y revocación de vínculos de tenencia
Relaciones: PROPIETARIO_TITULAR, COPROPIETARIO e INQUILINO. El primer vínculo activo debe ser titular; el último titular requiere reemplazo previo.
Crear, cambiar o restaurar requiere rol vigente; altas y restauraciones requieren unidad activa. Revocar sigue permitido aunque el rol esté revocado.
Cambio real: vínculo, revisión global y auditoría atómicos; tokens previos revocados. Repetir la misma operación conserva fila, revisión e historial.
Fuente: specs/02-domains/05-usuarios-rbac/vinculos-departamentos.md</bpmn:documentation>
    <bpmn:laneSet id="CON_05_LaneSet">
      <bpmn:lane id="CON_05_Lane_0" name="Administración">
        <bpmn:flowNodeRef>CON_05_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_seleccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CON_05_Lane_1" name="Sistema CondoManager">
        <bpmn:flowNodeRef>CON_05_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_autorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_operacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_reglas_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_reglas_baja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_reglas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_cambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_sin_cambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_05_rechazado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CON_05_inicio" name="Gestionar vínculo">
      <bpmn:outgoing>CON_05_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CON_05_seleccionar" name="Seleccionar usuario, condominio y departamento">
      <bpmn:incoming>CON_05_Flow_0</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CON_05_solicitar" name="Elegir operación y relación de tenencia">
      <bpmn:incoming>CON_05_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_05_validar" name="Validar actor, contexto, usuario y departamento">
      <bpmn:incoming>CON_05_Flow_2</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_05_autorizado" name="¿Solicitud autorizada y recursos existentes?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_05_Flow_3</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>CON_05_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CON_05_operacion" name="¿Operación solicitada?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_05_Flow_4</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>CON_05_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_05_reglas_alta" name="Validar rol, actividad de unidad y reglas de titulares">
      <bpmn:incoming>CON_05_Flow_6</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CON_05_reglas_baja" name="Comprobar vínculo y protección del último titular">
      <bpmn:incoming>CON_05_Flow_7</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_05_reglas" name="¿Cumple reglas de la operación?" gatewayDirection="Mixed">
      <bpmn:incoming>CON_05_Flow_8</bpmn:incoming>
      <bpmn:incoming>CON_05_Flow_9</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>CON_05_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CON_05_cambio" name="¿Existe cambio real?" gatewayDirection="Diverging">
      <bpmn:incoming>CON_05_Flow_11</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>CON_05_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_05_guardar" name="Guardar vínculo, revisión y auditoría de forma atómica">
      <bpmn:incoming>CON_05_Flow_12</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CON_05_sin_cambio" name="Devolver vínculo actual sin duplicar cambios">
      <bpmn:incoming>CON_05_Flow_13</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CON_05_resultado" name="Revisar relación y estado del vínculo">
      <bpmn:incoming>CON_05_Flow_14</bpmn:incoming>
      <bpmn:incoming>CON_05_Flow_15</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CON_05_fin" name="Vínculo gestionado">
      <bpmn:incoming>CON_05_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CON_05_error" name="" gatewayDirection="Converging">
      <bpmn:incoming>CON_05_Flow_5</bpmn:incoming>
      <bpmn:incoming>CON_05_Flow_10</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_05_rechazar" name="Informar motivo y conservar el vínculo anterior">
      <bpmn:incoming>CON_05_Flow_17</bpmn:incoming>
      <bpmn:outgoing>CON_05_Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_05_rechazado" name="Solicitud rechazada">
      <bpmn:incoming>CON_05_Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CON_05_Flow_0" sourceRef="CON_05_inicio" targetRef="CON_05_seleccionar" />
    <bpmn:sequenceFlow id="CON_05_Flow_1" sourceRef="CON_05_seleccionar" targetRef="CON_05_solicitar" />
    <bpmn:sequenceFlow id="CON_05_Flow_2" sourceRef="CON_05_solicitar" targetRef="CON_05_validar" />
    <bpmn:sequenceFlow id="CON_05_Flow_3" sourceRef="CON_05_validar" targetRef="CON_05_autorizado" />
    <bpmn:sequenceFlow id="CON_05_Flow_4" sourceRef="CON_05_autorizado" targetRef="CON_05_operacion" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_5" sourceRef="CON_05_autorizado" targetRef="CON_05_error" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_6" sourceRef="CON_05_operacion" targetRef="CON_05_reglas_alta" name="Crear / cambiar / restaurar">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Crear / cambiar / restaurar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_7" sourceRef="CON_05_operacion" targetRef="CON_05_reglas_baja" name="Revocar">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Revocar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_8" sourceRef="CON_05_reglas_alta" targetRef="CON_05_reglas" />
    <bpmn:sequenceFlow id="CON_05_Flow_9" sourceRef="CON_05_reglas_baja" targetRef="CON_05_reglas" />
    <bpmn:sequenceFlow id="CON_05_Flow_10" sourceRef="CON_05_reglas" targetRef="CON_05_error" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_11" sourceRef="CON_05_reglas" targetRef="CON_05_cambio" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_12" sourceRef="CON_05_cambio" targetRef="CON_05_guardar" name="Sí">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_13" sourceRef="CON_05_cambio" targetRef="CON_05_sin_cambio" name="No">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CON_05_Flow_14" sourceRef="CON_05_guardar" targetRef="CON_05_resultado" />
    <bpmn:sequenceFlow id="CON_05_Flow_15" sourceRef="CON_05_sin_cambio" targetRef="CON_05_resultado" />
    <bpmn:sequenceFlow id="CON_05_Flow_16" sourceRef="CON_05_resultado" targetRef="CON_05_fin" />
    <bpmn:sequenceFlow id="CON_05_Flow_17" sourceRef="CON_05_error" targetRef="CON_05_rechazar" />
    <bpmn:sequenceFlow id="CON_05_Flow_18" sourceRef="CON_05_rechazar" targetRef="CON_05_rechazado" />
  </bpmn:process>
  <bpmn:collaboration id="CON_05_Collaboration">
    <bpmn:participant id="CON_05_Participant" name="CondoManager · CON-05" processRef="CON_05_Process" />
  </bpmn:collaboration>

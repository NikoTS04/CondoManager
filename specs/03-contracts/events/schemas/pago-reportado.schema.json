{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagoReportadoEvent",
  "type": "object",
  "required": ["event_id", "event_type", "producer", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "PagoReportadoEvent"},
    "producer": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "required": [
        "comprobante_id",
        "condominio_id",
        "departamento_id",
        "banco",
        "numero_operacion",
        "monto"
      ],
      "properties": {
        "comprobante_id": {"type": "string", "format": "uuid"},
        "condominio_id": {"type": "string", "format": "uuid"},
        "departamento_id": {"type": "string", "format": "uuid"},
        "banco": {"type": "string", "minLength": 1},
        "numero_operacion": {"type": "string", "minLength": 1},
        "fecha_operacion": {"type": "string", "format": "date"},
        "monto": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

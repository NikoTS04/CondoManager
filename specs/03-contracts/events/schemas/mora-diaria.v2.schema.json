{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mora diaria — cargos y compensaciones v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "producer", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["MoraAplicadaEvent", "MoraAjustadaEvent"]},
    "schema_version": {"const": 2},
    "producer": {"const": "service.pagos"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condominio_id", "departamento_id", "cuota_id", "devengo_id", "fecha_local", "importe", "saldo_pendiente", "moneda", "comprobante_causante_id"],
      "properties": {
        "condominio_id": {"type": "string", "format": "uuid"},
        "departamento_id": {"type": "string", "format": "uuid"},
        "cuota_id": {"type": "string", "format": "uuid"},
        "devengo_id": {"type": "string", "format": "uuid"},
        "fecha_local": {"type": "string", "format": "date"},
        "importe": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,9})\\.[0-9]{2}$", "not": {"enum": ["0.00", "-0.00"]}},
        "saldo_pendiente": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "moneda": {"enum": ["PEN", "USD"]},
        "comprobante_causante_id": {"type": ["string", "null"], "format": "uuid"}
      }
    }
  },
  "if": {"properties": {"event_type": {"const": "MoraAplicadaEvent"}}},
  "then": {"properties": {"data": {"properties": {"importe": {"pattern": "^[0-9]+\\.[0-9]{2}$"}}}}}
}

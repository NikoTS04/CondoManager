{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope de pagos persistentes CON-70 version 1",
  "description": "Contrato aditivo del productor real. No sustituye el payload plano histórico de pago-conciliado.schema.json.",
  "type": "object",
  "required": ["event_id", "event_type", "version", "producer", "occurred_at", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "enum": ["PagoReportadoEvent", "PagoConciliadoEvent", "PagoObservadoEvent", "PagoRechazadoEvent"] },
    "version": { "const": 1 },
    "producer": { "const": "service.pagos" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["comprobante_id", "departamento_id", "condominio_id", "estado", "monto", "motivo"],
      "properties": {
        "comprobante_id": { "type": "string", "format": "uuid" },
        "departamento_id": { "type": "string", "format": "uuid" },
        "condominio_id": { "type": "string", "format": "uuid" },
        "estado": { "enum": ["EN_REVISION", "APROBADO", "OBSERVADO", "RECHAZADO"] },
        "monto": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "motivo": { "type": ["string", "null"] },
        "revision_id": { "type": "string", "format": "uuid" },
        "resultado": {
          "type": "object",
          "required": ["comprobante_id", "estado_final", "monto_imputado", "nuevo_saldo_departamento", "saldo_a_favor_generado", "departamento_habilitado_reservas"],
          "properties": {
            "comprobante_id": { "type": "string", "format": "uuid" },
            "estado_final": { "enum": ["APROBADO", "OBSERVADO", "RECHAZADO"] },
            "monto_imputado": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
            "nuevo_saldo_departamento": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
            "saldo_a_favor_generado": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
            "departamento_habilitado_reservas": { "type": "boolean" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "enum": ["PagoConciliadoEvent", "PagoObservadoEvent", "PagoRechazadoEvent"] } } },
      "then": { "properties": { "data": { "required": ["revision_id", "resultado"] } } }
    }
  ]
}

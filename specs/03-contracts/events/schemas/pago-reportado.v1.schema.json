{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagoReportadoEventV1",
  "allOf": [{"$ref": "./event-envelope.v1.schema.json"}],
  "properties": {
    "event_type": {"const": "PagoReportadoEvent"},
    "producer": {"const": "service.pagos"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condominio_id", "departamento_id", "comprobante_id", "estado", "monto", "fecha_operacion"],
      "properties": {
        "condominio_id": {"$ref": "./event-envelope.v1.schema.json#/$defs/uuid"},
        "departamento_id": {"$ref": "./event-envelope.v1.schema.json#/$defs/uuid"},
        "comprobante_id": {"$ref": "./event-envelope.v1.schema.json#/$defs/uuid"},
        "estado": {"const": "EN_REVISION"},
        "monto": {"$ref": "./event-envelope.v1.schema.json#/$defs/dinero_positivo"},
        "fecha_operacion": {"type": "string", "format": "date"}
      }
    }
  },
  "unevaluatedProperties": false
}

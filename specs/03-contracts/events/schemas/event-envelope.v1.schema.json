{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CondoManagerDomainEventV1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "producer", "occurred_at", "correlation_id", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "const": 1},
    "producer": {"type": "string", "minLength": 1},
    "occurred_at": {"$ref": "#/$defs/instante_utc"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "data": {"type": "object"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "dinero": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$"},
    "dinero_positivo": {"type": "string", "pattern": "^(0\\.(0[1-9]|[1-9][0-9])|[1-9][0-9]{0,9}\\.[0-9]{2})$"},
    "hora_local": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:00$"},
    "instante_utc": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "ajuste_cancelacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "monto", "referencia"],
      "properties": {
        "estado": {"enum": ["NO_APLICA", "PENDIENTE", "APLICADO"]},
        "monto": {"$ref": "#/$defs/dinero"},
        "referencia": {"type": ["string", "null"], "format": "uuid"}
      },
      "allOf": [
        {
          "if": {"properties": {"estado": {"const": "NO_APLICA"}}},
          "then": {"properties": {"monto": {"const": "0.00"}, "referencia": {"type": "null"}}}
        },
        {
          "if": {"properties": {"estado": {"const": "APLICADO"}}},
          "then": {"properties": {"referencia": {"type": "string", "format": "uuid"}}}
        }
      ]
    }
  }
}

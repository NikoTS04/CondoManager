{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservaCanceladaEvent",
  "type": "object",
  "required": ["event_id", "event_type", "producer", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "ReservaCanceladaEvent"},
    "producer": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "required": [
        "reserva_id",
        "condominio_id",
        "departamento_id",
        "area",
        "fecha_reserva",
        "horario",
        "motivo"
      ],
      "properties": {
        "reserva_id": {"type": "string", "format": "uuid"},
        "condominio_id": {"type": "string", "format": "uuid"},
        "departamento_id": {"type": "string", "format": "uuid"},
        "area_id": {"type": "string", "format": "uuid"},
        "area": {"type": "string", "minLength": 1},
        "fecha_reserva": {"type": "string", "format": "date"},
        "hora_inicio": {"type": "string"},
        "hora_fin": {"type": "string"},
        "horario": {"type": "string", "minLength": 1},
        "motivo": {"type": "string", "minLength": 1},
        "ajuste_economico": {"type": ["string", "null"]},
        "monto_reembolso": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

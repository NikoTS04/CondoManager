{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CuotasEmitidasEvent",
  "type": "object",
  "required": ["event_id", "event_type", "producer", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "CuotasEmitidasEvent"},
    "schema_version": {"type": "integer", "const": 1},
    "producer": {"const": "service.cuotas"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "data": {
      "type": "object",
      "required": ["condominio_id", "presupuesto_id", "metodo", "lote_id", "periodo", "total_cuotas_emitidas", "monto_total_facturado", "cuotas_cubiertas_saldo_favor", "fecha_emision", "fecha_vencimiento"],
      "properties": {
        "condominio_id": {"type": "string", "format": "uuid"},
        "presupuesto_id": {"type": "string", "format": "uuid"},
        "metodo": {"enum": ["POR_ALICUOTA", "EQUITATIVA"]},
        "lote_id": {"type": "string", "format": "uuid"},
        "periodo": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "total_cuotas_emitidas": {"type": "integer", "minimum": 1},
        "monto_total_facturado": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "cuotas_cubiertas_saldo_favor": {"type": "integer", "minimum": 0},
        "fecha_emision": {"type": "string", "format": "date-time"},
        "fecha_vencimiento": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

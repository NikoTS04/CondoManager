{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CuotaEmitidaEvent",
  "type": "object",
  "required": ["event_id", "condominio_id", "periodo", "total_cuotas", "total_facturado", "fecha_vencimiento"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "condominio_id": { "type": "string", "format": "uuid" },
    "periodo": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "total_cuotas": { "type": "integer", "minimum": 1 },
    "total_facturado": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
    "fecha_vencimiento": { "type": "string", "format": "date" }
  }
}

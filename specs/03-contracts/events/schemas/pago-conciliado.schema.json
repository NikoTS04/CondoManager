{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagoConciliadoEvent",
  "type": "object",
  "required": ["event_id", "comprobante_id", "departamento_id", "monto_conciliado", "saldo_restante_departamento"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "comprobante_id": { "type": "string", "format": "uuid" },
    "departamento_id": { "type": "string", "format": "uuid" },
    "monto_conciliado": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
    "saldo_restante_departamento": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
    "desbloqueo_reservas_habilitado": { "type": "boolean" }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "functions": {
        "src/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,docs/**,specs/**,src/tests/**,uploads/**,data/**,venv/**,.venv/**,.env*}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "APP_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/v1/jobs/notificaciones", "destination": { "service": "app" } },
    { "source": "/api/v1/notificaciones/mailjet/eventos", "destination": { "service": "app" } },
    { "source": "/api/v1/jobs/diario", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [{"path": "/api/v1/jobs/diario", "schedule": "15 5 * * *"}]
}

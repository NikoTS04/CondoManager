# Configuración del Entorno de Desarrollo Local para CondoManager

# Base de Datos PostgreSQL
POSTGRES_USER=condo_user
POSTGRES_PASSWORD=condo_secret
POSTGRES_DB=condomanager
DATABASE_URL=postgresql+asyncpg://condo_user:condo_secret@localhost:5432/condomanager
DATABASE_URL_SYNC=postgresql://condo_user:condo_secret@localhost:5432/condomanager

# Broker Redis
REDIS_URL=redis://localhost:6379/0
# Día UTC de inicio de emisión mensual (1..28); worker separado con recuperación diaria.
CUOTAS_DIA_EMISION=1

# MinIO / Almacenamiento S3
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=condo_minio_admin
MINIO_ROOT_PASSWORD=condo_minio_secret
MINIO_BUCKET_VOUCHERS=condomanager-vouchers

# CON-22: almacén local privado temporal. Relativo a la raíz del proyecto.
# No es una URL pública. Compartir vouchers requiere usar el mismo backend/carpeta.
VOUCHERS_DIR=uploads/vouchers

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_condo_manager_jwt_key_development_only_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITACION_EXPIRE_HOURS=24
ACTIVACION_WEB_URL=http://localhost:3000/activar
# Fernet: generar una vez y compartir entre API/worker; conservar fuera de la base.
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
IDENTITY_DELIVERY_KEY=

# UUID real retornado por POST /api/v1/condominios para los usuarios demo de junta.
CONDOMINIO_PILOTO_ID=
# Habilita solamente el listado de perfiles demo; el login siempre usa PostgreSQL.
# Cargar las cuentas: python -m scripts.seed_usuarios_demo (después de migrar).
# Catálogo de áreas demo: python -m scripts.seed_areas_demo (después del condominio).
DEMO_MODE=true
# Variables públicas de Next.js: se fijan al compilar la imagen/frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false

# CON-78: correo transaccional. SIMULADO no sale a la red (útil para pruebas sin servidor).
# SMTP exige host y remitente; usuario y contraseña van juntos o ambos vacíos.
# Con Docker Compose el valor por omisión es SMTP contra Mailpit (http://localhost:8025).
# Ambiente demo: proveedor real (p. ej. Brevo/SendGrid/Gmail SMTP), SMTP_SEGURIDAD=STARTTLS
# o SSL, y solo cuentas de prueba autorizadas. No versionar credenciales reales.
EMAIL_TRANSPORTE=SIMULADO
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURIDAD=STARTTLS
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
SMTP_NOMBRE_REMITENTE=CondoManager
SMTP_TIMEOUT_SEGUNDOS=15

# CON-33: recordatorios de vencimiento por EMAIL. Se programan una vez al día desde la hora
# indicada (America/Lima) para cuotas con saldo que vencen dentro de la anticipación.
RECORDATORIOS_ACTIVOS=true
RECORDATORIO_DIAS_ANTICIPACION=3
RECORDATORIO_HORA_LIMA=8

# Servidor API
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Configuración del Entorno de Desarrollo Local para CondoManager

# Base de Datos PostgreSQL
POSTGRES_USER=condo_user
POSTGRES_PASSWORD=condo_secret
POSTGRES_DB=condomanager
DATABASE_URL=postgresql+asyncpg://condo_user:condo_secret@localhost:5432/condomanager
DATABASE_URL_SYNC=postgresql://condo_user:condo_secret@localhost:5432/condomanager

# Broker Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / Almacenamiento S3
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=condo_minio_admin
MINIO_ROOT_PASSWORD=condo_minio_secret
MINIO_BUCKET_VOUCHERS=condomanager-vouchers

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_condo_manager_jwt_key_development_only_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Servidor API
HOST=0.0.0.0
PORT=8000
DEBUG=True
